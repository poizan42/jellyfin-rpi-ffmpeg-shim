"""ffprobe passthrough.

Jellyfin derives the ffprobe path from the --ffmpeg path by regex
(MediaEncoder.cs:221), so a shim at <dir>/ffmpeg forces <dir>/ffprobe to exist.
This does nothing but exec the real ffprobe with the arguments unchanged.
"""
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from _orch import load_config, real_binary, exec_real, log  # noqa: E402

try:
    cfg = load_config()
    real = real_binary(cfg, "ffprobe", "ffprobe")
    exec_real(real, sys.argv[1:])
except Exception as exc:  # never let the shim break probing
    log("ffprobe passthrough failed: %s" % exc)
    # best-effort: try a bare ffprobe on PATH
    os.execvp("ffprobe", ["ffprobe"] + sys.argv[1:])
